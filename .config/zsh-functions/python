#---PYTHON AUTOMATION-----------------------------------------------------
# vim: syntax=zsh

_unset_venv()
{
	printf >&2 "[Leaving venv %s]\n" "$VIRTUAL_ENV"

	unset VENV_NAME
	unset VIRTUAL_ENV
	unset PYTHONPATH

	export PATH=$DEFAULT_PATH

	unset "PROMPT_INFO[venv]"

	set_prompt
}

activate_venv()
{
	local SELECTED_VENV=$1
	readonly local CURR_DIR="$PWD"

	# Check if we're still in the same tree as the currently selected VENV
	# There's a special case for $HOME/venv where we use that regardless,
	# but also check for a local-to-this-directory venv if available.
	if [ -n "$VIRTUAL_ENV" ] && [ "$VIRTUAL_ENV" != "${HOME}/venv" ]
	then
		readonly OLD_BASE_DIR="${VIRTUAL_ENV%/*}/"

		# If we're in a subdirectory of a non-HOME venv, just keep it as is.
		if [ "${CURR_DIR#$OLD_BASE_DIR}" != "${CURR_DIR}" ]
		then
			return 0
		fi
	fi

	# Find the best venv available
	if [ -z "$SELECTED_VENV" ]
	then
		if [ -d "${CURR_DIR}/.venv" ]
		then
			SELECTED_VENV="${CURR_DIR}/.venv"
		elif [ -d "${CURR_DIR}/venv" ]
		then
			SELECTED_VENV="${CURR_DIR}/venv"
		else
			SELECTED_VENV="${HOME}/.venv"
		fi
	fi

	# Resolve any links
	if [ -e "$SELECTED_VENV" ]
	then
		SELECTED_VENV=$(readlink -f "$SELECTED_VENV")
	fi
	readonly SELECTED_VENV

	# Check to confirm this is a real venv
	if ! [ -d "$SELECTED_VENV" ]
	then
		# Clear an existing venv if there is one
		if [ -n "$VIRTUAL_ENV" ]
		then
			_unset_venv
		fi
		return 0
	fi

	# In the case we're reselecting the home venv, do nothing.
	if [ "$VIRTUAL_ENV" = "$SELECTED_VENV" ]
	then
		return 0
	fi

	# Activate the venv
	printf >&2 "[Entering venv %s]\n" "$SELECTED_VENV"
	readonly local BASE_DIR="${SELECTED_VENV%/*}"

	export VIRTUAL_ENV="${SELECTED_VENV}"
	export PATH="${SELECTED_VENV}/bin:$DEFAULT_PATH"
	export PROMPT_INFO[venv]="$(basename ${BASE_DIR})"

	# Set up the python path
	local _PY_PATH=""

	if [ -d "${BASE_DIR}/tests" ]
	then
		_PY_PATH="${BASE_DIR}/tests:${_PY_PATH}"
	fi
	if [ -d "${BASE_DIR}/src" ]
	then
		_PY_PATH="${BASE_DIR}/src:${_PY_PATH}"
	fi

	PYTHONPATH=${_PY_PATH%:}
	export PYTHONPATH

	set_prompt
}

add-zsh-hook chpwd activate_venv
VIRTUAL_ENV=
activate_venv

python()
{
	venv
	command python3 "$@"
}

pip()
{
	venv
	command pip "$@"
}

venv()
{
	test -n "$VIRTUAL_ENV" && return 0

	local GITDIR=$(command git rev-parse --show-toplevel 2>/dev/null)
	GITDIR=${GITDIR:-$(pwd)}
	readonly GITDIR

	printf >&2 "Create venv in %s? [Yn]" "$GITDIR/.venv"
	read -r CREATE

	test "$CREATE" = "n" || test "$CREATE" = "N" || test "$CREATE" = "no"

	if [ $? -ne 0 ]
	then
		command python3 -m venv --upgrade-deps --symlinks --clear "$GITDIR/.venv"
		activate_venv
	fi
}

alias python3=python
