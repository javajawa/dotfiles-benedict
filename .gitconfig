[user]
	email = benedict.harcourt@futurenet.com
	name = Benedict Harcourt
	signingkey = /Users/benedict.harcourt/.ssh/id_ed25519.pub
[core]
	excludesFile = /Users/benedict.harcourt/.gitignore_global

[commit]
	verbose = 1
	gpgsign = 1
[gpg]
	format = ssh
[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = /Users/benedict.harcourt/.ssh/allowed_signers

[init]
	defaultBranch = mainline

[pull]
	ff = only
[push]
	autoSetupRemote = true

[diff]
	tool = kitty
[difftool]
	prompt = false
	trustExitCode = true
[difftool "kitty"]
	cmd = kitten diff $LOCAL $REMOTE
[alias]
	idiff = difftool --no-symlinks --dir-diff
