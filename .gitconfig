[user]
	email = ben.harcourt@harcourtprogramming.co.uk
	name = Benedict Harcourt
	signingkey = ~/.ssh/id_ed25519.pub
[core]
	excludesFile = ~/.gitignore_global

[commit]
	verbose = 1
	gpgsign = 1
[gpg]
	format = ssh

[init]
	defaultBranch = mainline

[pull]
	ff = only
[push]
	autoSetupRemote = true

[diff]
	tool = kitty
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[difftool]
	prompt = false
	trustExitCode = true
[difftool "kitty"]
	cmd = kitten diff $LOCAL $REMOTE
[alias]
	idiff = difftool --no-symlinks --dir-diff
[tag]
	sort = version:refname
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
